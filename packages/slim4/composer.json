{
  "name": "duckbug/duckbug-slim4",
  "type": "library",
  "description": "Slim 4 integration for the DuckBug PHP SDK",
  "keywords": [
    "duckbug",
    "slim4",
    "error-monitoring"
  ],
  "homepage": "https://duckbug.io",
  "license": "MIT",
  "authors": [
    {
      "name": "DuckBug",
      "email": "help@duckbug.io"
    }
  ],
  "require": {
    "php": ">=7.2",
    "duckbug/duckbug-core": "^0.1|dev-main",
    "slim/slim": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "DuckBug\\Integrations\\Slim4\\": "src/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "symlink": true
      }
    }
  ]
}
