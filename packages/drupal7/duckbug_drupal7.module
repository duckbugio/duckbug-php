<?php

/**
 * @file
 * Drupal 7 module entrypoint for DuckBug.
 */

function _duckbug_drupal7_include_autoload()
{
    static $autoloaded = false;

    if ($autoloaded) {
        return;
    }

    $candidates = array(
        dirname(__FILE__) . '/vendor/autoload.php',
    );

    if (defined('DRUPAL_ROOT')) {
        $candidates[] = DRUPAL_ROOT . '/vendor/autoload.php';
    }

    foreach ($candidates as $autoloadFile) {
        if (is_file($autoloadFile)) {
            require_once $autoloadFile;
            $autoloaded = true;
            return;
        }
    }
}

function duckbug_drupal7_boot()
{
    _duckbug_drupal7_include_autoload();

    if (!class_exists('DuckBug\\Integrations\\Drupal7\\Drupal7Bootstrap')) {
        return;
    }

    \DuckBug\Integrations\Drupal7\Drupal7Bootstrap::boot();
}

function duckbug_drupal7_init()
{
    _duckbug_drupal7_include_autoload();

    if (!class_exists('DuckBug\\Integrations\\Drupal7\\Drupal7Bootstrap')) {
        return;
    }

    \DuckBug\Integrations\Drupal7\Drupal7Bootstrap::boot();
}

function duckbug_drupal7_watchdog(array $log_entry)
{
    _duckbug_drupal7_include_autoload();

    if (!class_exists('DuckBug\\Integrations\\Drupal7\\Drupal7Bootstrap')) {
        return;
    }

    \DuckBug\Integrations\Drupal7\Drupal7Bootstrap::captureWatchdog($log_entry);
}
