{
  "name": "duckbug/duckbug-symfony",
  "type": "library",
  "description": "Symfony integration for the DuckBug PHP SDK",
  "keywords": [
    "duckbug",
    "symfony",
    "error-monitoring"
  ],
  "homepage": "https://duckbug.io",
  "license": "MIT",
  "authors": [
    {
      "name": "DuckBug",
      "email": "help@duckbug.io"
    }
  ],
  "require": {
    "php": ">=7.1",
    "duckbug/duckbug-core": "^0.1|dev-main",
    "symfony/http-kernel": "^4.4|^5.4|^6.0|^7.0"
  },
  "autoload": {
    "psr-4": {
      "DuckBug\\Integrations\\Symfony\\": "src/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "symlink": true
      }
    }
  ]
}
