{
  "name": "duckbug/duckbug-drupal",
  "type": "drupal-module",
  "description": "Drupal 9/10/11 module integration for the DuckBug PHP SDK",
  "keywords": [
    "duckbug",
    "drupal",
    "error-monitoring",
    "logging"
  ],
  "homepage": "https://duckbug.io",
  "license": "MIT",
  "authors": [
    {
      "name": "DuckBug",
      "email": "help@duckbug.io"
    }
  ],
  "require": {
    "php": ">=8.1",
    "duckbug/duckbug-core": "^0.1|dev-main",
    "drupal/core": "^9.5 || ^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "DuckBug\\Integrations\\Drupal\\": "src/"
    }
  },
  "extra": {
    "installer-name": "duckbug"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "symlink": true
      }
    }
  ]
}
