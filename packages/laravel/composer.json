{
  "name": "duckbug/duckbug-laravel",
  "type": "library",
  "description": "Laravel integration for the DuckBug PHP SDK",
  "keywords": [
    "duckbug",
    "laravel",
    "error-monitoring"
  ],
  "homepage": "https://duckbug.io",
  "license": "MIT",
  "authors": [
    {
      "name": "DuckBug",
      "email": "help@duckbug.io"
    }
  ],
  "require": {
    "php": ">=7.1",
    "duckbug/duckbug-core": "^0.1|dev-main",
    "illuminate/support": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "DuckBug\\Integrations\\Laravel\\": "src/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "symlink": true
      }
    }
  ]
}
