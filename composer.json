{
  "name": "duckbug/duckbug",
  "type": "library",
  "description": "Compatibility package and full PHP SDK for DuckBug (https://duckbug.io)",
  "keywords": [
    "duckbug",
    "log",
    "logging",
    "error-monitoring",
    "error-handler",
    "crash-reporting",
    "crash-reports",
    "profiling",
    "tracing"
  ],
  "homepage": "https://duckbug.io",
  "license": "MIT",
  "authors": [
    {
      "name": "DuckBug",
      "email": "help@duckbug.io"
    }
  ],
  "require": {
    "php": ">=7.1",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "guzzlehttp/psr7": "^1.8.4|^2.1.1",
    "psr/log": "^1.0|^2.0|^3.0",
    "psr/http-server-middleware": "^1.0",
    "nyholm/psr7-server": "^1.1",
    "nyholm/psr7": "^1.6"
  },
  "require-dev": {
    "vimeo/psalm": ">=4.30",
    "friendsofphp/php-cs-fixer": ">=3.3",
    "psalm/plugin-phpunit": ">=0.18.4",
    "overtrue/phplint": ">=3.2",
    "phpunit/phpunit": ">=7.0",
    "dms/phpunit-arraysubset-asserts": ">=0.5.0",
    "dg/bypass-finals": "^1.9",
    "phpbench/phpbench": ">=0.16.10",
    "monolog/monolog": "^1.25|^2.0|^3.0",
    "symfony/http-kernel": "^4.0|^5.0|^6.0"
  },
  "replace": {
    "duckbug/duckbug-core": "self.version",
    "duckbug/duckbug-symfony": "self.version",
    "duckbug/duckbug-laravel": "self.version",
    "duckbug/duckbug-yii2": "self.version",
    "duckbug/duckbug-slim4": "self.version",
    "duckbug/duckbug-wordpress": "self.version",
    "duckbug/duckbug-drupal": "self.version",
    "duckbug/duckbug-drupal7": "self.version"
  },
  "suggest": {
    "monolog/monolog": "For the DuckBug Monolog handler integration",
    "symfony/http-kernel": "For the Symfony exception listener integration",
    "laravel/framework": "For the Laravel service provider integration",
    "yiisoft/yii2": "For the Yii2 log target and error handler integrations",
    "slim/slim": "For the Slim 4 middleware and error handler integrations",
    "wordpress/wordpress": "For the WordPress bootstrap, hooks and plugin integration",
    "drupal/core": "For the Drupal 9/10/11 module integration",
    "drupal/drupal": "For the Drupal 7 legacy module integration"
  },
  "autoload": {
    "psr-4": {
      "DuckBug\\": "src/",
      "DuckBug\\Integrations\\Yii2\\": "packages/yii2/src/",
      "DuckBug\\Integrations\\Slim4\\": "packages/slim4/src/",
      "DuckBug\\Integrations\\WordPress\\": "packages/wordpress/src/",
      "DuckBug\\Integrations\\Drupal\\": "packages/drupal/src/",
      "DuckBug\\Integrations\\Drupal7\\": "packages/drupal7/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DuckBug\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "php-cs-fixer": "php-cs-fixer --config=.php-cs-fixer.php --allow-risky=yes",
    "lint": "phplint",
    "psalm": "psalm",
    "test": "phpunit --colors=always",
    "phpbench": "phpbench run"
  }
}
